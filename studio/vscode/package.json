{
  "name": "flogo-datapipeline-studio",
  "displayName": "Flogo Data Pipeline Studio",
  "description": "Visual ETL/ELT/EL pipeline designer for flogo-datapipeline — drag-and-drop source, transform and sink stages with live run metrics, DLQ triage, schema-drift review and streaming tail.",
  "version": "0.2.0",
  "publisher": "tibco",
  "icon": "resources/icon-128.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/mpandav-tibco/flogo-datapipeline"
  },
  "engines": {
    "vscode": "^1.83.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "languages": [
      {
        "id": "flogo-datapipeline",
        "aliases": [
          "Flogo Data Pipeline",
          "datapipeline"
        ],
        "extensions": [
          ".datapipeline"
        ],
        "mimetypes": [
          "application/vnd.flogo.datapipeline+json"
        ],
        "icon": {
          "light": "resources/icon.svg",
          "dark": "resources/icon.svg"
        },
        "configuration": "./language-configuration.json"
      },
      {
        "id": "flogo-connection",
        "aliases": [
          "Flogo Connection"
        ],
        "extensions": [
          ".fgconn"
        ],
        "icon": {
          "light": "resources/connection-icon.svg",
          "dark": "resources/connection-icon.svg"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "flogo-datapipeline",
        "scopeName": "source.flogo-datapipeline",
        "path": "./syntaxes/flogo-datapipeline.tmLanguage.json"
      }
    ],
    "customEditors": [
      {
        "viewType": "flogoDataPipelineStudio.pipelineEditor",
        "displayName": "Flogo Data Pipeline Studio",
        "selector": [
          {
            "filenamePattern": "*.datapipeline"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "flogoDataPipelineStudio.connectionEditor",
        "displayName": "Flogo Connection",
        "selector": [
          {
            "filenamePattern": "*.fgconn"
          }
        ],
        "priority": "default"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": "*.datapipeline",
        "url": "./schemas/datapipeline.schema.json"
      },
      {
        "fileMatch": "*.fgconn",
        "url": "./schemas/fgconn.schema.json"
      }
    ],
    "commands": [
      {
        "command": "flogoDataPipelineStudio.runPipeline",
        "title": "Run in Data Pipeline Studio",
        "category": "Data Pipeline",
        "icon": "$(play)"
      },
      {
        "command": "flogoDataPipelineStudio.stopPipeline",
        "title": "Stop Pipeline",
        "category": "Data Pipeline",
        "icon": "$(debug-stop)"
      },
      {
        "command": "flogoDataPipelineStudio.newPipeline",
        "title": "New Data Pipeline File…",
        "category": "Data Pipeline",
        "icon": "$(new-file)"
      },
      {
        "command": "flogoDataPipelineStudio.newFromTemplate",
        "title": "New Pipeline from Template…",
        "category": "Data Pipeline",
        "icon": "$(library)"
      },
      {
        "command": "flogoDataPipelineStudio.build",
        "title": "Build",
        "category": "Data Pipeline",
        "icon": "$(package)"
      },
      {
        "command": "flogoDataPipelineStudio.runWithOptions",
        "title": "Configure and Run",
        "category": "Data Pipeline",
        "icon": "$(debug-coverage)"
      },
      {
        "command": "flogoDataPipelineStudio.configure",
        "title": "Configure Build & Run",
        "category": "Data Pipeline",
        "icon": "$(gear)"
      },
      {
        "command": "flogoDataPipelineStudio.openFleet",
        "title": "Open Fleet Dashboard",
        "category": "Data Pipeline",
        "icon": "$(dashboard)"
      },
      {
        "command": "flogoDataPipelineStudio.initProject",
        "title": "Initialize Project Structure",
        "category": "Data Pipeline",
        "icon": "$(folder-library)"
      },
      {
        "command": "flogoDataPipelineStudio.newConnection",
        "title": "New Connection…",
        "category": "Data Pipeline",
        "icon": "$(add)"
      },
      {
        "command": "flogoDataPipelineStudio.refreshConnections",
        "title": "Refresh Connections",
        "category": "Data Pipeline",
        "icon": "$(refresh)"
      },
      {
        "command": "flogoDataPipelineStudio.editConnection",
        "title": "Edit Connection",
        "category": "Data Pipeline",
        "icon": "$(edit)"
      },
      {
        "command": "flogoDataPipelineStudio.testConnection",
        "title": "Test Connection",
        "category": "Data Pipeline",
        "icon": "$(pulse)"
      },
      {
        "command": "flogoDataPipelineStudio.deleteConnection",
        "title": "Delete Connection",
        "category": "Data Pipeline",
        "icon": "$(trash)"
      },
      {
        "command": "flogoDataPipelineStudio.revealConnectionsFile",
        "title": "Where are Connections stored?",
        "category": "Data Pipeline",
        "icon": "$(info)"
      }
    ],
    "views": {
      "flogoDataPipelineActivity": [
        {
          "id": "flogoDataPipelineStudio.pipelinesExplorer",
          "name": "Pipelines",
          "type": "tree",
          "icon": "resources/icon.svg",
          "contextualTitle": "Flogo Data Pipelines"
        },
        {
          "id": "flogoDataPipelineStudio.connectionsExplorer",
          "name": "Connections",
          "type": "tree",
          "icon": "resources/icon.svg",
          "contextualTitle": "Flogo Data Pipelines"
        }
      ],
      "explorer": [
        {
          "id": "flogoDataPipelineStudio.pipelinesExplorerMirror",
          "name": "Flogo Data Pipelines",
          "type": "tree",
          "icon": "resources/icon.svg",
          "contextualTitle": "Flogo Data Pipelines",
          "when": "workbenchState != empty"
        },
        {
          "id": "flogoDataPipelineStudio.connectionsExplorerMirror",
          "name": "Pipeline Connections",
          "type": "tree",
          "icon": "resources/icon.svg",
          "contextualTitle": "Flogo Data Pipelines",
          "when": "workbenchState != empty"
        }
      ],
      "flogoDataPipelinePanel": [
        {
          "id": "flogoDataPipelineStudio.dataPreview",
          "name": "Data Preview",
          "type": "webview",
          "contextualTitle": "Data Pipeline"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "flogoDataPipelineActivity",
          "title": "Flogo Data Pipelines",
          "icon": "resources/icon.svg"
        }
      ],
      "panel": [
        {
          "id": "flogoDataPipelinePanel",
          "title": "Data Preview",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "flogoDataPipelineStudio.build",
          "when": "view == flogoDataPipelineStudio.pipelinesExplorer || view == flogoDataPipelineStudio.pipelinesExplorerMirror",
          "group": "navigation@0"
        },
        {
          "command": "flogoDataPipelineStudio.newFromTemplate",
          "when": "view == flogoDataPipelineStudio.pipelinesExplorer || view == flogoDataPipelineStudio.pipelinesExplorerMirror",
          "group": "navigation@1"
        },
        {
          "command": "flogoDataPipelineStudio.newPipeline",
          "when": "view == flogoDataPipelineStudio.pipelinesExplorer || view == flogoDataPipelineStudio.pipelinesExplorerMirror",
          "group": "navigation@2"
        },
        {
          "command": "flogoDataPipelineStudio.initProject",
          "when": "view == flogoDataPipelineStudio.pipelinesExplorer || view == flogoDataPipelineStudio.pipelinesExplorerMirror",
          "group": "1_setup@0"
        },
        {
          "command": "flogoDataPipelineStudio.newConnection",
          "when": "view == flogoDataPipelineStudio.connectionsExplorer || view == flogoDataPipelineStudio.connectionsExplorerMirror",
          "group": "navigation@0"
        },
        {
          "command": "flogoDataPipelineStudio.refreshConnections",
          "when": "view == flogoDataPipelineStudio.connectionsExplorer || view == flogoDataPipelineStudio.connectionsExplorerMirror",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "flogoDataPipelineStudio.testConnection",
          "when": "(view == flogoDataPipelineStudio.connectionsExplorer || view == flogoDataPipelineStudio.connectionsExplorerMirror) && viewItem == flogoConnection",
          "group": "inline@0"
        },
        {
          "command": "flogoDataPipelineStudio.editConnection",
          "when": "(view == flogoDataPipelineStudio.connectionsExplorer || view == flogoDataPipelineStudio.connectionsExplorerMirror) && viewItem == flogoConnection",
          "group": "1_modify@0"
        },
        {
          "command": "flogoDataPipelineStudio.deleteConnection",
          "when": "(view == flogoDataPipelineStudio.connectionsExplorer || view == flogoDataPipelineStudio.connectionsExplorerMirror) && viewItem == flogoConnection",
          "group": "9_danger@0"
        }
      ],
      "explorer/context": [
        {
          "command": "flogoDataPipelineStudio.newPipeline",
          "when": "explorerResourceIsFolder",
          "group": "navigation@30"
        },
        {
          "command": "flogoDataPipelineStudio.newFromTemplate",
          "when": "explorerResourceIsFolder",
          "group": "navigation@31"
        },
        {
          "command": "flogoDataPipelineStudio.runPipeline",
          "when": "resourceExtname == .datapipeline",
          "group": "flogo@1"
        },
        {
          "command": "flogoDataPipelineStudio.build",
          "when": "resourceExtname == .datapipeline",
          "group": "flogo@2"
        }
      ],
      "editor/title": [
        {
          "command": "flogoDataPipelineStudio.runPipeline",
          "when": "resourceExtname == .datapipeline || activeCustomEditorId == flogoDataPipelineStudio.pipelineEditor",
          "group": "navigation@1"
        },
        {
          "command": "flogoDataPipelineStudio.build",
          "when": "resourceExtname == .datapipeline || activeCustomEditorId == flogoDataPipelineStudio.pipelineEditor",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "flogoDataPipelineStudio.runPipeline",
          "when": "resourceExtname == .datapipeline || activeCustomEditorId == flogoDataPipelineStudio.pipelineEditor"
        },
        {
          "command": "flogoDataPipelineStudio.build",
          "when": "resourceExtname == .datapipeline || activeCustomEditorId == flogoDataPipelineStudio.pipelineEditor"
        },
        {
          "command": "flogoDataPipelineStudio.runWithOptions",
          "when": "resourceExtname == .datapipeline || activeCustomEditorId == flogoDataPipelineStudio.pipelineEditor"
        },
        {
          "command": "flogoDataPipelineStudio.newConnection"
        },
        {
          "command": "flogoDataPipelineStudio.revealConnectionsFile"
        },
        {
          "command": "flogoDataPipelineStudio.editConnection",
          "when": "false"
        },
        {
          "command": "flogoDataPipelineStudio.testConnection",
          "when": "false"
        },
        {
          "command": "flogoDataPipelineStudio.deleteConnection",
          "when": "false"
        },
        {
          "command": "flogoDataPipelineStudio.refreshConnections",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Flogo Data Pipeline Studio",
      "properties": {
        "flogoDataPipelineStudio.binaryPath": {
          "type": "string",
          "default": "",
          "description": "Path to the flogo-datapipeline binary. Defaults to bin/flogo-datapipeline[.exe] inside the extension directory."
        },
        "flogoDataPipelineStudio.apiPort": {
          "type": "number",
          "default": 9080,
          "description": "Starting port for the Flogo Data Pipeline REST API. Auto-increments if the port is in use."
        },
        "flogoDataPipelineStudio.sourcePath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the flogo-datapipeline Go module root (the directory containing go.mod). When set, Run rebuilds the binary from source before starting the engine. Leave empty to use the pre-built binary."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src webview --ext ts"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.83.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.6.3",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.4"
  }
}
