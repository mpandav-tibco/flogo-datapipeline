{
 "name": "el11_postgres_parquet",
 "type": "flogo:app",
 "version": "1.0.0",
 "appModel": "1.1.1",
 "imports": [
  "github.com/mpandav-tibco/flogo-datapipeline/action/pipeline",
  "github.com/project-flogo/contrib/trigger/timer"
 ],
 "triggers": [
  {
   "id": "bench-timer",
   "ref": "github.com/project-flogo/contrib/trigger/timer",
   "settings": {
    "repeating": true,
    "startDelay": 0,
    "interval": 86400000
   },
   "handlers": [
    {
     "settings": {},
     "action": {
      "ref": "github.com/mpandav-tibco/flogo-datapipeline/action/pipeline",
      "settings": {
       "pipelineRef": "res://pipeline:el11_postgres_parquet"
      }
     }
    }
   ]
  }
 ],
 "resources": [
  {
   "id": "pipeline:el11_postgres_parquet",
   "data": {
    "mode": "el",
    "source": {
     "type": "jdbc",
     "driver": "postgres",
     "dsn": "postgres://postgres:bench@localhost:5433/warehouse?sslmode=disable",
     "table": "orders_raw",
     "keyColumn": "order_id",
     "batchSize": 5000,
     "partitions": 4
    },
    "transforms": [],
    "sink": {
     "type": "parquet",
     "path": "./out/el11.parquet",
     "compression": "snappy",
     "rowGroupSize": 100000
    },
    "performance": {
     "batchSize": 5000,
     "maxMemoryMB": 1024
    },
    "scaling": {
     "mode": "single"
    },
    "checkpoint": {
     "type": "none"
    },
    "name": "el11_postgres_parquet"
   }
  }
 ]
}