{
 "name": "etl11_csv_lookup_parquet",
 "type": "flogo:app",
 "version": "1.0.0",
 "appModel": "1.1.1",
 "imports": [
  "github.com/mpandav-tibco/flogo-datapipeline/action/pipeline",
  "github.com/project-flogo/contrib/trigger/timer"
 ],
 "triggers": [
  {
   "id": "bench-timer",
   "ref": "github.com/project-flogo/contrib/trigger/timer",
   "settings": {
    "repeating": true,
    "startDelay": 0,
    "interval": 86400000
   },
   "handlers": [
    {
     "settings": {},
     "action": {
      "ref": "github.com/mpandav-tibco/flogo-datapipeline/action/pipeline",
      "settings": {
       "pipelineRef": "res://pipeline:etl11_csv_lookup_parquet"
      }
     }
    }
   ]
  }
 ],
 "resources": [
  {
   "id": "pipeline:etl11_csv_lookup_parquet",
   "data": {
    "mode": "etl",
    "source": {
     "type": "csv",
     "path": "./data/orders.csv",
     "delimiter": ",",
     "hasHeader": true,
     "columns": [
      {
       "name": "order_id",
       "type": "string"
      },
      {
       "name": "customer_id",
       "type": "string"
      },
      {
       "name": "region",
       "type": "string"
      },
      {
       "name": "product",
       "type": "string"
      },
      {
       "name": "category",
       "type": "string"
      },
      {
       "name": "quantity",
       "type": "int"
      },
      {
       "name": "unit_price",
       "type": "float"
      },
      {
       "name": "status",
       "type": "string"
      },
      {
       "name": "order_date",
       "type": "string"
      },
      {
       "name": "email",
       "type": "string"
      }
     ]
    },
    "transforms": [
     {
      "type": "lookup",
      "url": "http://localhost:9099/enrich/{region}",
      "method": "GET",
      "keyField": "region",
      "outputFields": [
       "region_name",
       "region_tier"
      ],
      "concurrency": 8,
      "cacheSize": 100,
      "timeoutMs": 3000,
      "onError": "null"
     },
     {
      "type": "map",
      "fieldOrder": [
       "order_id",
       "customer_id",
       "region_code",
       "product",
       "category",
       "quantity",
       "net_amount",
       "status",
       "order_date",
       "email"
      ],
      "fields": {
       "order_id": "=$order_id",
       "customer_id": "=$customer_id",
       "region_code": "=upper($.region)",
       "product": "=$product",
       "category": "=$category",
       "quantity": "=$quantity",
       "net_amount": "=multiply($.quantity, $.unit_price)",
       "status": "=$status",
       "order_date": "=$order_date",
       "email": "=lower($.email)"
      }
     }
    ],
    "sink": {
     "type": "parquet",
     "path": "./out/etl11.parquet",
     "compression": "snappy",
     "rowGroupSize": 100000
    },
    "performance": {
     "batchSize": 5000,
     "maxMemoryMB": 1024
    },
    "scaling": {
     "mode": "single"
    },
    "checkpoint": {
     "type": "none"
    },
    "name": "etl11_csv_lookup_parquet"
   }
  }
 ]
}