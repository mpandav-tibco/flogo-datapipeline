{
 "name": "el15_kafka_postgres",
 "type": "flogo:app",
 "version": "1.0.0",
 "appModel": "1.1.1",
 "imports": [
  "github.com/lib/pq",
  "github.com/mpandav-tibco/flogo-datapipeline/action/pipeline",
  "github.com/mpandav-tibco/flogo-datapipeline/sink/jdbc",
  "github.com/mpandav-tibco/flogo-datapipeline/source/kafka",
  "github.com/project-flogo/contrib/trigger/timer"
 ],
 "triggers": [
  {
   "id": "bench-timer",
   "ref": "github.com/project-flogo/contrib/trigger/timer",
   "settings": {
    "repeating": true,
    "startDelay": 0,
    "interval": 86400000
   },
   "handlers": [
    {
     "settings": {},
     "action": {
      "ref": "github.com/mpandav-tibco/flogo-datapipeline/action/pipeline",
      "settings": {
       "pipelineRef": "res://pipeline:el15_kafka_postgres"
      }
     }
    }
   ]
  }
 ],
 "resources": [
  {
   "id": "pipeline:el15_kafka_postgres",
   "data": {
    "mode": "el",
    "source": {
     "type": "kafka",
     "options": {
      "brokers": [
       "localhost:9092"
      ],
      "topic": "orders",
      "mode": "batch",
      "groupId": "g_el15",
      "startOffset": "earliest",
      "stopAtCurrentEnd": true,
      "batchSize": 5000
     }
    },
    "transforms": [],
    "sink": {
     "type": "jdbc",
     "driver": "postgres",
     "dsn": "postgres://postgres:bench@localhost:5433/warehouse?sslmode=disable",
     "table": "orders_sink",
     "batchSize": 5000,
     "onConflict": "insert"
    },
    "performance": {
     "batchSize": 5000,
     "maxMemoryMB": 1024
    },
    "scaling": {
     "mode": "single"
    },
    "checkpoint": {
     "type": "none"
    },
    "name": "el15_kafka_postgres"
   }
  }
 ]
}