{
 "name": "_prep_load_pg",
 "type": "flogo:app",
 "version": "1.0.0",
 "appModel": "1.1.1",
 "imports": [
  "github.com/mpandav-tibco/flogo-datapipeline/action/pipeline",
  "github.com/project-flogo/contrib/trigger/timer"
 ],
 "triggers": [
  {
   "id": "bench-timer",
   "ref": "github.com/project-flogo/contrib/trigger/timer",
   "settings": {
    "repeating": true,
    "startDelay": 0,
    "interval": 86400000
   },
   "handlers": [
    {
     "settings": {},
     "action": {
      "ref": "github.com/mpandav-tibco/flogo-datapipeline/action/pipeline",
      "settings": {
       "pipelineRef": "res://pipeline:_prep_load_pg"
      }
     }
    }
   ]
  }
 ],
 "resources": [
  {
   "id": "pipeline:_prep_load_pg",
   "data": {
    "mode": "el",
    "source": {
     "type": "csv",
     "path": "./data/orders.csv",
     "delimiter": ",",
     "hasHeader": true,
     "columns": [
      {
       "name": "order_id",
       "type": "string"
      },
      {
       "name": "customer_id",
       "type": "string"
      },
      {
       "name": "region",
       "type": "string"
      },
      {
       "name": "product",
       "type": "string"
      },
      {
       "name": "category",
       "type": "string"
      },
      {
       "name": "quantity",
       "type": "int"
      },
      {
       "name": "unit_price",
       "type": "float"
      },
      {
       "name": "status",
       "type": "string"
      },
      {
       "name": "order_date",
       "type": "string"
      },
      {
       "name": "email",
       "type": "string"
      }
     ]
    },
    "transforms": [],
    "sink": {
     "type": "jdbc",
     "driver": "postgres",
     "dsn": "postgres://postgres:bench@localhost:5433/warehouse?sslmode=disable",
     "table": "orders_raw",
     "batchSize": 5000,
     "onConflict": "insert"
    },
    "performance": {
     "batchSize": 5000,
     "maxMemoryMB": 1024
    },
    "scaling": {
     "mode": "single"
    },
    "checkpoint": {
     "type": "none"
    },
    "name": "_prep_load_pg"
   }
  }
 ]
}