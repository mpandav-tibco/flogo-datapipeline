{
 "name": "etl04_csv_full_s3",
 "type": "flogo:app",
 "version": "1.0.0",
 "appModel": "1.1.1",
 "imports": [
  "github.com/mpandav-tibco/flogo-datapipeline/action/pipeline",
  "github.com/mpandav-tibco/flogo-datapipeline/objstore/s3",
  "github.com/mpandav-tibco/flogo-datapipeline/sink/objstore",
  "github.com/mpandav-tibco/flogo-datapipeline/sink/parquet",
  "github.com/mpandav-tibco/flogo-datapipeline/source/csv",
  "github.com/mpandav-tibco/flogo-datapipeline/transform/filter",
  "github.com/mpandav-tibco/flogo-datapipeline/transform/mapper",
  "github.com/mpandav-tibco/flogo-datapipeline/transform/validate",
  "github.com/project-flogo/contrib/trigger/timer"
 ],
 "triggers": [
  {
   "id": "bench-timer",
   "ref": "github.com/project-flogo/contrib/trigger/timer",
   "settings": {
    "repeating": true,
    "startDelay": 0,
    "interval": 86400000
   },
   "handlers": [
    {
     "settings": {},
     "action": {
      "ref": "github.com/mpandav-tibco/flogo-datapipeline/action/pipeline",
      "settings": {
       "pipelineRef": "res://pipeline:etl04_csv_full_s3"
      }
     }
    }
   ]
  }
 ],
 "resources": [
  {
   "id": "pipeline:etl04_csv_full_s3",
   "data": {
    "mode": "etl",
    "source": {
     "type": "csv",
     "path": "./data/orders.csv",
     "delimiter": ",",
     "hasHeader": true,
     "columns": [
      {
       "name": "order_id",
       "type": "string"
      },
      {
       "name": "customer_id",
       "type": "string"
      },
      {
       "name": "region",
       "type": "string"
      },
      {
       "name": "product",
       "type": "string"
      },
      {
       "name": "category",
       "type": "string"
      },
      {
       "name": "quantity",
       "type": "int"
      },
      {
       "name": "unit_price",
       "type": "float"
      },
      {
       "name": "status",
       "type": "string"
      },
      {
       "name": "order_date",
       "type": "string"
      },
      {
       "name": "email",
       "type": "string"
      }
     ]
    },
    "transforms": [
     {
      "type": "filter",
      "expr": "status != 'CANCELLED' AND unit_price > 0"
     },
     {
      "type": "validate",
      "rules": [
       {
        "field": "order_id",
        "notNull": true,
        "pattern": "^ORD-[0-9]+$"
       },
       {
        "field": "quantity",
        "notNull": true,
        "min": 1,
        "max": 1000
       },
       {
        "field": "unit_price",
        "notNull": true,
        "min": 0.01,
        "max": 100000
       },
       {
        "field": "status",
        "in": [
         "PENDING",
         "SHIPPED",
         "DELIVERED",
         "CANCELLED"
        ]
       },
       {
        "field": "email",
        "pattern": "^[^@]+@[^@]+\\.[^@]+$"
       }
      ],
      "onViolation": "route",
      "errorSinkType": "null",
      "errorSinkConfig": {}
     },
     {
      "type": "map",
      "fieldOrder": [
       "order_id",
       "customer_id",
       "region_code",
       "product",
       "category",
       "quantity",
       "net_amount",
       "status",
       "order_date",
       "email"
      ],
      "fields": {
       "order_id": "=$order_id",
       "customer_id": "=$customer_id",
       "region_code": "=upper($.region)",
       "product": "=$product",
       "category": "=$category",
       "quantity": "=$quantity",
       "net_amount": "=multiply($.quantity, $.unit_price)",
       "status": "=$status",
       "order_date": "=$order_date",
       "email": "=lower($.email)"
      }
     }
    ],
    "sink": {
     "bucket": "datalake",
     "region": "us-east-1",
     "endpoint": "http://localhost:9000",
     "forcePathStyle": true,
     "accessKeyIdEnv": "MINIO_AK",
     "secretAccessKeyEnv": "MINIO_SK",
     "type": "s3-sink",
     "key": "etl/clean.parquet",
     "format": "parquet"
    },
    "performance": {
     "batchSize": 5000,
     "maxMemoryMB": 1024
    },
    "scaling": {
     "mode": "single"
    },
    "checkpoint": {
     "type": "none"
    },
    "name": "etl04_csv_full_s3"
   }
  }
 ]
}