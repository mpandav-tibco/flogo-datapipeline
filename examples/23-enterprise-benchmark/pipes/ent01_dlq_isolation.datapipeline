{
 "name": "ent01_dlq_isolation",
 "type": "flogo:app",
 "version": "1.0.0",
 "appModel": "1.1.1",
 "imports": [
  "github.com/mpandav-tibco/flogo-datapipeline/action/pipeline",
  "github.com/project-flogo/contrib/trigger/timer"
 ],
 "triggers": [
  {
   "id": "bench-timer",
   "ref": "github.com/project-flogo/contrib/trigger/timer",
   "settings": {
    "repeating": true,
    "startDelay": 0,
    "interval": 86400000
   },
   "handlers": [
    {
     "settings": {},
     "action": {
      "ref": "github.com/mpandav-tibco/flogo-datapipeline/action/pipeline",
      "settings": {
       "pipelineRef": "res://pipeline:ent01_dlq_isolation"
      }
     }
    }
   ]
  }
 ],
 "resources": [
  {
   "id": "pipeline:ent01_dlq_isolation",
   "data": {
    "mode": "etl",
    "source": {
     "type": "csv",
     "path": "./data/orders.csv",
     "delimiter": ",",
     "hasHeader": true,
     "columns": [
      {
       "name": "order_id",
       "type": "string"
      },
      {
       "name": "customer_id",
       "type": "string"
      },
      {
       "name": "region",
       "type": "string"
      },
      {
       "name": "product",
       "type": "string"
      },
      {
       "name": "category",
       "type": "string"
      },
      {
       "name": "quantity",
       "type": "int"
      },
      {
       "name": "unit_price",
       "type": "float"
      },
      {
       "name": "status",
       "type": "string"
      },
      {
       "name": "order_date",
       "type": "string"
      },
      {
       "name": "email",
       "type": "string"
      }
     ]
    },
    "transforms": [
     {
      "type": "validate",
      "rules": [
       {
        "field": "order_id",
        "notNull": true,
        "pattern": "^ORD-[0-9]+$"
       },
       {
        "field": "quantity",
        "notNull": true,
        "min": 1,
        "max": 1000
       },
       {
        "field": "unit_price",
        "notNull": true,
        "min": 0.01,
        "max": 100000
       },
       {
        "field": "status",
        "in": [
         "PENDING",
         "SHIPPED",
         "DELIVERED",
         "CANCELLED"
        ]
       },
       {
        "field": "email",
        "pattern": "^[^@]+@[^@]+\\.[^@]+$"
       }
      ],
      "onViolation": "route",
      "errorSinkType": "jdbc",
      "errorSinkConfig": {
       "driver": "postgres",
       "dsn": "postgres://postgres:bench@localhost:5433/warehouse?sslmode=disable",
       "table": "orders_rejects",
       "batchSize": 5000
      }
     }
    ],
    "sink": {
     "type": "parquet",
     "path": "./out/ent01_good.parquet",
     "compression": "snappy",
     "rowGroupSize": 100000
    },
    "performance": {
     "batchSize": 5000,
     "maxMemoryMB": 1024
    },
    "scaling": {
     "mode": "single"
    },
    "checkpoint": {
     "type": "none"
    },
    "name": "ent01_dlq_isolation"
   }
  }
 ]
}