{
 "name": "el13_postgres_s3",
 "type": "flogo:app",
 "version": "1.0.0",
 "appModel": "1.1.1",
 "imports": [
  "github.com/lib/pq",
  "github.com/mpandav-tibco/flogo-datapipeline/action/pipeline",
  "github.com/mpandav-tibco/flogo-datapipeline/objstore/s3",
  "github.com/mpandav-tibco/flogo-datapipeline/sink/objstore",
  "github.com/mpandav-tibco/flogo-datapipeline/sink/parquet",
  "github.com/mpandav-tibco/flogo-datapipeline/source/jdbc",
  "github.com/project-flogo/contrib/trigger/timer"
 ],
 "triggers": [
  {
   "id": "bench-timer",
   "ref": "github.com/project-flogo/contrib/trigger/timer",
   "settings": {
    "repeating": true,
    "startDelay": 0,
    "interval": 86400000
   },
   "handlers": [
    {
     "settings": {},
     "action": {
      "ref": "github.com/mpandav-tibco/flogo-datapipeline/action/pipeline",
      "settings": {
       "pipelineRef": "res://pipeline:el13_postgres_s3"
      }
     }
    }
   ]
  }
 ],
 "resources": [
  {
   "id": "pipeline:el13_postgres_s3",
   "data": {
    "mode": "el",
    "source": {
     "type": "jdbc",
     "driver": "postgres",
     "dsn": "postgres://postgres:bench@localhost:5433/warehouse?sslmode=disable",
     "table": "orders_raw",
     "orderKey": "order_id",
     "batchSize": 5000,
     "partitions": 4
    },
    "transforms": [],
    "sink": {
     "bucket": "datalake",
     "region": "us-east-1",
     "endpoint": "http://localhost:9000",
     "forcePathStyle": true,
     "accessKeyIdEnv": "MINIO_AK",
     "secretAccessKeyEnv": "MINIO_SK",
     "type": "s3-sink",
     "key": "el/pg.parquet",
     "format": "parquet"
    },
    "performance": {
     "batchSize": 5000,
     "maxMemoryMB": 1024
    },
    "scaling": {
     "mode": "single"
    },
    "checkpoint": {
     "type": "none"
    },
    "name": "el13_postgres_s3"
   }
  }
 ]
}