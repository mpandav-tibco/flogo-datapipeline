{
 "name": "etl09_csv_dq_parquet",
 "type": "flogo:app",
 "version": "1.0.0",
 "appModel": "1.1.1",
 "imports": [
  "github.com/mpandav-tibco/flogo-datapipeline/action/pipeline",
  "github.com/project-flogo/contrib/trigger/timer"
 ],
 "triggers": [
  {
   "id": "bench-timer",
   "ref": "github.com/project-flogo/contrib/trigger/timer",
   "settings": {
    "repeating": true,
    "startDelay": 0,
    "interval": 86400000
   },
   "handlers": [
    {
     "settings": {},
     "action": {
      "ref": "github.com/mpandav-tibco/flogo-datapipeline/action/pipeline",
      "settings": {
       "pipelineRef": "res://pipeline:etl09_csv_dq_parquet"
      }
     }
    }
   ]
  }
 ],
 "resources": [
  {
   "id": "pipeline:etl09_csv_dq_parquet",
   "data": {
    "mode": "etl",
    "source": {
     "type": "csv",
     "path": "./data/orders.csv",
     "delimiter": ",",
     "hasHeader": true,
     "columns": [
      {
       "name": "order_id",
       "type": "string"
      },
      {
       "name": "customer_id",
       "type": "string"
      },
      {
       "name": "region",
       "type": "string"
      },
      {
       "name": "product",
       "type": "string"
      },
      {
       "name": "category",
       "type": "string"
      },
      {
       "name": "quantity",
       "type": "int"
      },
      {
       "name": "unit_price",
       "type": "float"
      },
      {
       "name": "status",
       "type": "string"
      },
      {
       "name": "order_date",
       "type": "string"
      },
      {
       "name": "email",
       "type": "string"
      }
     ]
    },
    "transforms": [
     {
      "type": "dq",
      "expectations": [
       {
        "type": "expectColumnNotNull",
        "column": "order_id",
        "threshold": 1.0
       },
       {
        "type": "expectColumnValuesBetween",
        "column": "unit_price",
        "min": 0.01,
        "max": 100000
       },
       {
        "type": "expectColumnValuesInSet",
        "column": "status",
        "values": [
         "PENDING",
         "SHIPPED",
         "DELIVERED",
         "CANCELLED"
        ]
       }
      ],
      "qualityThreshold": 0.95,
      "onFail": "warn"
     }
    ],
    "sink": {
     "type": "parquet",
     "path": "./out/etl09.parquet",
     "compression": "snappy",
     "rowGroupSize": 100000
    },
    "performance": {
     "batchSize": 5000,
     "maxMemoryMB": 1024
    },
    "scaling": {
     "mode": "single"
    },
    "checkpoint": {
     "type": "none"
    },
    "name": "etl09_csv_dq_parquet"
   }
  }
 ]
}