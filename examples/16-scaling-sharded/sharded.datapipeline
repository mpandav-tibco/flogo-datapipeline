{
  "name": "sharded-orders",
  "type": "flogo:app",
  "version": "1.0.0",
  "description": "Multi-instance sharding example: each instance reads one partition file determined by INSTANCE_INDEX. Set INSTANCE_INDEX (0-based) and INSTANCE_COUNT before launching. The engine resolves './data/partition_{index}.csv' where {index} = INSTANCE_INDEX. A filter removes low-value orders (value <= 10) before the null sink discards all remaining rows. No coordinator, no shared state, no Redis or Postgres required.",
  "appModel": "1.1.1",
  "imports": [
    "github.com/mpandav-tibco/flogo-datapipeline/action/pipeline",
    "github.com/project-flogo/contrib/trigger/timer"
  ],
  "triggers": [
    {
      "id": "pipeline-timer",
      "ref": "github.com/project-flogo/contrib/trigger/timer",
      "settings": {
        "repeating": true,
        "startDelay": 0,
        "interval": 86400000
      },
      "handlers": [
        {
          "settings": {},
          "action": {
            "ref": "github.com/mpandav-tibco/flogo-datapipeline/action/pipeline",
            "settings": {
              "pipelineRef": "res://pipeline:sharded-orders"
            }
          }
        }
      ]
    }
  ],
  "resources": [
    {
      "id": "pipeline:sharded-orders",
      "data": {
        "name": "sharded-orders",
        "description": "Multi-instance sharding example: each instance reads one partition file determined by INSTANCE_INDEX. Set INSTANCE_INDEX (0-based) and INSTANCE_COUNT before launching. The engine resolves './data/partition_{index}.csv' where {index} = INSTANCE_INDEX. A filter removes low-value orders (value <= 10) before the null sink discards all remaining rows. No coordinator, no shared state, no Redis or Postgres required.",
        "version": "1.0.0",
        "mode": "etl",
        "source": {
          "type": "csv",
          "path": "./data/partition_{index}.csv",
          "delimiter": ",",
          "hasHeader": true,
          "columns": [
            {
              "name": "id",
              "type": "int"
            },
            {
              "name": "customer_id",
              "type": "string"
            },
            {
              "name": "product_sku",
              "type": "string"
            },
            {
              "name": "quantity",
              "type": "int"
            },
            {
              "name": "unit_price",
              "type": "float"
            },
            {
              "name": "value",
              "type": "float"
            },
            {
              "name": "region",
              "type": "string"
            },
            {
              "name": "status",
              "type": "string"
            },
            {
              "name": "order_date",
              "type": "string"
            }
          ]
        },
        "transforms": [
          {
            "type": "filter",
            "expr": "value > 10"
          }
        ],
        "sink": {
          "type": "null"
        },
        "performance": {
          "batchSize": 5000,
          "maxMemoryMB": 512
        },
        "scaling": {
          "mode": "sharded",
          "instanceIndex": 0,
          "instanceCount": 3
        },
        "checkpoint": {
          "type": "none"
        }
      }
    }
  ]
}