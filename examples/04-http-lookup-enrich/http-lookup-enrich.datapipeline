{
  "name": "http-lookup-enrich",
  "type": "flogo:app",
  "version": "1.0.0",
  "description": "Enrich each row with data from an HTTP API, with an LRU cache to avoid re-fetching duplicates.",
  "appModel": "1.1.1",
  "imports": [
    "github.com/mpandav-tibco/flogo-datapipeline/action/pipeline",
    "github.com/project-flogo/contrib/trigger/timer"
  ],
  "triggers": [
    {
      "id": "pipeline-timer",
      "ref": "github.com/project-flogo/contrib/trigger/timer",
      "settings": {
        "repeating": true,
        "startDelay": 0,
        "interval": 86400000
      },
      "handlers": [
        {
          "settings": {},
          "action": {
            "ref": "github.com/mpandav-tibco/flogo-datapipeline/action/pipeline",
            "settings": {
              "pipelineRef": "res://pipeline:http-lookup-enrich"
            }
          }
        }
      ]
    }
  ],
  "resources": [
    {
      "id": "pipeline:http-lookup-enrich",
      "data": {
        "name": "http-lookup-enrich",
        "description": "Enrich each row with data from an HTTP API, with an LRU cache to avoid re-fetching duplicates.",
        "version": "1.0.0",
        "mode": "etl",
        "source": {
          "type": "csv",
          "path": "./data/users.csv",
          "delimiter": ",",
          "hasHeader": true,
          "columns": [
            {
              "name": "user_id",
              "type": "int"
            },
            {
              "name": "name",
              "type": "string"
            },
            {
              "name": "plan_type",
              "type": "string"
            },
            {
              "name": "amount",
              "type": "float"
            }
          ]
        },
        "transforms": [
          {
            "type": "lookup",
            "url": "https://jsonplaceholder.typicode.com/users/{user_id}",
            "method": "GET",
            "keyField": "user_id",
            "outputFields": [
              "username",
              "email",
              "phone",
              "website"
            ],
            "concurrency": 5,
            "cacheSize": 100,
            "timeoutMs": 3000,
            "onError": "null"
          },
          {
            "type": "map",
            "fields": {
              "user_id": "=$user_id",
              "name": "=$name",
              "username": "=coalesce($.username, $.name)",
              "email": "=coalesce($.email, 'unknown@example.com')",
              "plan": "=$plan_type"
            }
          }
        ],
        "sink": {
          "type": "null"
        },
        "performance": {
          "batchSize": 5000,
          "maxMemoryMB": 512
        },
        "scaling": {
          "mode": "single"
        },
        "checkpoint": {
          "type": "none"
        },
        "ui": {
          "source": {
            "x": 38,
            "y": 80
          },
          "transforms": [
            {
              "x": 263,
              "y": 126
            },
            {
              "x": 471,
              "y": 262
            }
          ],
          "sink": {
            "x": 693,
            "y": 178
          }
        }
      }
    }
  ]
}