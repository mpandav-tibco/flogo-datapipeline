{
  "name": "inventory-jdbc-source",
  "type": "flogo:app",
  "version": "1.0.0",
  "description": "Read all rows from a SQLite products table using keyset pagination and partition-aware reads. Demonstrates the JDBC source with zero external dependencies — SQLite is a single file on disk.",
  "appModel": "1.1.1",
  "imports": [
    "github.com/mpandav-tibco/flogo-datapipeline/action/pipeline",
    "github.com/project-flogo/contrib/trigger/timer"
  ],
  "triggers": [
    {
      "id": "pipeline-timer",
      "ref": "github.com/project-flogo/contrib/trigger/timer",
      "settings": {
        "repeating": true,
        "startDelay": 0,
        "interval": 86400000
      },
      "handlers": [
        {
          "settings": {},
          "action": {
            "ref": "github.com/mpandav-tibco/flogo-datapipeline/action/pipeline",
            "settings": {
              "pipelineRef": "res://pipeline:inventory-jdbc-source"
            }
          }
        }
      ]
    }
  ],
  "resources": [
    {
      "id": "pipeline:inventory-jdbc-source",
      "data": {
        "name": "inventory-jdbc-source",
        "description": "Read all rows from a SQLite products table using keyset pagination and partition-aware reads. Demonstrates the JDBC source with zero external dependencies — SQLite is a single file on disk.",
        "version": "1.0.0",
        "mode": "el",
        "source": {
          "type": "jdbc",
          "driver": "sqlite",
          "dsn": "./data/inventory.db",
          "table": "products",
          "keyColumn": "product_id",
          "batchSize": 100,
          "partitions": 2
        },
        "transforms": [],
        "sink": {
          "type": "null"
        },
        "performance": {
          "batchSize": 100,
          "maxMemoryMB": 256
        },
        "scaling": {
          "mode": "single"
        },
        "checkpoint": {
          "type": "none"
        }
      }
    }
  ]
}