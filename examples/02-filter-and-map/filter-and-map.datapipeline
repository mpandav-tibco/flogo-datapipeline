{
  "name": "filter-and-map",
  "type": "flogo:app",
  "version": "1.0.0",
  "description": "Reads sales.csv, drops rows that are CANCELLED or have an amount <= 100 cents, then re-shapes each surviving row into a clean output schema with uppercased region codes and amounts converted from cents to dollars.",
  "appModel": "1.1.1",
  "imports": [
    "github.com/mpandav-tibco/flogo-datapipeline/action/pipeline",
    "github.com/project-flogo/contrib/trigger/timer"
  ],
  "triggers": [
    {
      "id": "pipeline-timer",
      "ref": "github.com/project-flogo/contrib/trigger/timer",
      "settings": {
        "repeating": true,
        "startDelay": 0,
        "interval": 86400000
      },
      "handlers": [
        {
          "settings": {},
          "action": {
            "ref": "github.com/mpandav-tibco/flogo-datapipeline/action/pipeline",
            "settings": {
              "pipelineRef": "res://pipeline:filter-and-map"
            }
          }
        }
      ]
    }
  ],
  "resources": [
    {
      "id": "pipeline:filter-and-map",
      "data": {
        "name": "filter-and-map",
        "description": "Reads sales.csv, drops rows that are CANCELLED or have an amount <= 100 cents, then re-shapes each surviving row into a clean output schema with uppercased region codes and amounts converted from cents to dollars.",
        "version": "1.0.0",
        "mode": "etl",
        "source": {
          "type": "csv",
          "path": "/Users/milindpandav/git/flogo-datapipeline/examples/02-filter-and-map/data/sales.csv",
          "delimiter": ",",
          "hasHeader": true,
          "columns": [
            {
              "name": "id",
              "type": "int"
            },
            {
              "name": "region",
              "type": "string"
            },
            {
              "name": "product",
              "type": "string"
            },
            {
              "name": "amount",
              "type": "float"
            },
            {
              "name": "status",
              "type": "string"
            },
            {
              "name": "sale_date",
              "type": "string"
            }
          ]
        },
        "transforms": [
          {
            "type": "filter",
            "expr": "amount > 100 AND status != 'CANCELLED'"
          },
          {
            "type": "map",
            "fieldOrder": [
              "sale_id",
              "region_code",
              "product_name",
              "amount_usd",
              "processed_date"
            ],
            "fields": {
              "sale_id": "=$id",
              "region_code": "=upper($.region)",
              "product_name": "=$product",
              "amount_usd": "=divide($.amount, 100)",
              "processed_date": "=$sale_date"
            }
          }
        ],
        "sink": {
          "type": "null"
        },
        "performance": {
          "batchSize": 500,
          "maxMemoryMB": 256
        },
        "scaling": {
          "mode": "single"
        },
        "checkpoint": {
          "type": "none"
        },
        "ui": {
          "source": {
            "x": 40,
            "y": 40
          },
          "transforms": [
            {
              "x": 280,
              "y": 40
            },
            {
              "x": 530,
              "y": 44
            }
          ],
          "sink": {
            "x": 754,
            "y": 58
          },
          "positions": {
            "t0": {
              "x": 342,
              "y": 67
            },
            "t1": {
              "x": 669,
              "y": 47
            },
            "sink": {
              "x": 1220,
              "y": 110
            }
          }
        }
      }
    }
  ]
}