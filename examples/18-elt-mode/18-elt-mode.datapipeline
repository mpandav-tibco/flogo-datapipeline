{
  "name": "elt-mode",
  "description": "ELT pipeline: extract raw sales CSV and load it as-is to a SQLite staging table. All data transformations (aggregation, normalisation, currency conversion) happen inside the database via transform.sql — not in this pipeline.",
  "version": "1.0.0",
  "mode": "elt",
  "source": {
    "type": "csv",
    "path": "./data/raw_sales.csv",
    "delimiter": ",",
    "hasHeader": true,
    "columns": [
      { "name": "id",           "type": "string" },
      { "name": "region",       "type": "string" },
      { "name": "amount",       "type": "float"  },
      { "name": "currency",     "type": "string" },
      { "name": "sale_date",    "type": "string" },
      { "name": "raw_category", "type": "string" }
    ]
  },
  "transforms": [],
  "sink": {
    "type": "jdbc",
    "driver": "sqlite",
    "dsn": "./data/analytics.db",
    "table": "raw_sales_staging",
    "batchSize": 1000,
    "onConflict": "insert"
  },
  "postLoadHint": {
    "type": "sql",
    "script": "./transform.sql",
    "runner": "sqlite3",
    "runnerArgs": ["./data/analytics.db"]
  },
  "performance": {
    "batchSize": 5000,
    "maxMemoryMB": 512
  },
  "scaling": {
    "mode": "single"
  },
  "checkpoint": {
    "type": "none"
  }
}
