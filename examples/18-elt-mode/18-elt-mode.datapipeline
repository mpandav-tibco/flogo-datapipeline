{
  "name": "elt-mode",
  "type": "flogo:app",
  "version": "1.0.0",
  "description": "ELT pipeline: extract raw sales CSV and load it as-is to a SQLite staging table. All data transformations (aggregation, normalisation, currency conversion) happen inside the database via transform.sql — not in this pipeline.",
  "appModel": "1.1.1",
  "imports": [
    "github.com/mpandav-tibco/flogo-datapipeline/action/pipeline",
    "github.com/project-flogo/contrib/trigger/timer"
  ],
  "triggers": [
    {
      "id": "pipeline-timer",
      "ref": "github.com/project-flogo/contrib/trigger/timer",
      "settings": {
        "repeating": true,
        "startDelay": 0,
        "interval": 86400000
      },
      "handlers": [
        {
          "settings": {},
          "action": {
            "ref": "github.com/mpandav-tibco/flogo-datapipeline/action/pipeline",
            "settings": {
              "pipelineRef": "res://pipeline:elt-mode"
            }
          }
        }
      ]
    }
  ],
  "resources": [
    {
      "id": "pipeline:elt-mode",
      "data": {
        "name": "elt-mode",
        "description": "ELT pipeline: extract raw sales CSV and load it as-is to a SQLite staging table. All data transformations (aggregation, normalisation, currency conversion) happen inside the database via transform.sql — not in this pipeline.",
        "version": "1.0.0",
        "mode": "elt",
        "source": {
          "type": "csv",
          "path": "./data/raw_sales.csv",
          "delimiter": ",",
          "hasHeader": true,
          "columns": [
            {
              "name": "id",
              "type": "string"
            },
            {
              "name": "region",
              "type": "string"
            },
            {
              "name": "amount",
              "type": "float"
            },
            {
              "name": "currency",
              "type": "string"
            },
            {
              "name": "sale_date",
              "type": "string"
            },
            {
              "name": "raw_category",
              "type": "string"
            }
          ]
        },
        "transforms": [],
        "sink": {
          "type": "jdbc",
          "driver": "sqlite",
          "dsn": "./data/analytics.db",
          "table": "raw_sales_staging",
          "batchSize": 1000,
          "onConflict": "insert"
        },
        "postLoadHint": {
          "type": "sql",
          "script": "./transform.sql",
          "runner": "sqlite3",
          "runnerArgs": [
            "./data/analytics.db"
          ]
        },
        "performance": {
          "batchSize": 5000,
          "maxMemoryMB": 512
        },
        "scaling": {
          "mode": "single"
        },
        "checkpoint": {
          "type": "none"
        }
      }
    }
  ]
}