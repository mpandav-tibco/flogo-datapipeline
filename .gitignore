# Go binaries
*.exe
*.exe~
*.dll
*.so
*.dylib
# Built engine binaries — anchored to repo root so the cmd/flogo-datapipeline/
# SOURCE package (main.go, doc.go, …) stays tracked. Also ignore any built
# binary that happens to sit next to the source package.
/flogo-datapipeline
/flogo-datapipeline.exe
cmd/flogo-datapipeline/flogo-datapipeline
cmd/flogo-datapipeline/flogo-datapipeline.exe

# Go test artifacts
*.test
*.out
coverage.html
coverage.txt

# Go module cache / vendor
vendor/

# Build output
dist/
build/
# ...but keep the top-level build/ Go package (import-derivation source for dp-build)
!/build/
!/build/*.go

# Local run output (checkpoints, positions, NDJSON written to ./out)
/out/

# IDE
.idea/
.vscode/settings.json
*.swp
*.swo
.DS_Store
Thumbs.db

# VSCode extension — build artifacts only (keep source)
studio/vscode/node_modules/
studio/vscode/*.vsix
studio/vscode/*.tgz

# Example runtime artifacts (keep source data, ignore runtime output)
examples/*/checkpoints/
examples/*/watermarks/
examples/*/out/
examples/*/data/output.db
examples/*/data/analytics.db
examples/*/data/claims_enriched.db
examples/*/data/sensors.db
examples/*/data/*.db
!examples/*/data/inventory.db
!examples/*/data/events.db
!examples/*/data/claims.db

# Parquet test files (too large / binary — generated by user from README instructions)
examples/08-parquet-columnar/data/*.parquet

# Pipeline run history
**/.pipeline-history.json

# Environment / secrets
.env
*.env
secrets/

# dp-build transient codegen dir
.dpbuild/

# Local Go workspace (machine-specific replaces)
go.work
go.work.sum

# dp-bundled-artifacts (OOTB lean-build VSIX bundle — regenerated by scripts/build-bundled-vsix.sh)
/third_party/
/.dpbin/
/studio/vscode/bin/
/studio/vscode/media/dp-src/
/studio/vscode/dist-vsix/

# Generated enterprise-benchmark datasets & build artifacts (multi-GB, untracked).
# Excluded so editors/indexers — including the Copilot Chat workspace index —
# do not read them and OOM ("Worker terminated due to reaching memory limit").
/examples/23-enterprise-benchmark/data/
/examples/23-enterprise-benchmark/out/
/examples/23-enterprise-benchmark/bin/
